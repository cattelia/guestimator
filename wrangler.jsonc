{
  "name": "live-picking-dashboard",
  "compatibility_date": "2026-09-01",
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Cross-device sync is on — this namespace is what lets the roster,
  // active pickers, stamps, and shift goal show up the same on every
  // device you log into.
  "kv_namespaces": [
    { "binding": "GUESTIMATOR_APP_STATE", "id": "bc2c6ff51ef746d2848ed02acf950f6f" }
  ]

  // OPTIONAL — separately enables the 5-attempts-then-15-minute login
  // lockout feature. Create another KV namespace named LOGIN_ATTEMPTS the
  // same way, then add it as a second entry in the array above, e.g.:
  //
  // "kv_namespaces": [
  //   { "binding": "GUESTIMATOR_APP_STATE", "id": "bc2c6ff51ef746d2848ed02acf950f6f" },
  //   { "binding": "LOGIN_ATTEMPTS", "id": "PASTE_NAMESPACE_ID_HERE" }
  // ]
}
